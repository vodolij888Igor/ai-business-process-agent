# Copy to `.env` and set secrets locally (never commit `.env`).

# Required for POST /run-business-agent (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override default model (defaults to gpt-4o-mini in code if unset)
# OPENAI_MODEL=gpt-4o-mini

# Host interface for Uvicorn (default 127.0.0.1)
HOST=127.0.0.1

# Port for local development
PORT=8000

# Optional: application environment name
# ENVIRONMENT=development
