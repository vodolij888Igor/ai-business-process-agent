# Copy to `.env` and adjust when you add settings-based configuration (e.g. pydantic-settings).
# v1 does not read these automatically; they document intended deployment variables.

# Host interface for Uvicorn (default 127.0.0.1)
HOST=127.0.0.1

# Port for local development
PORT=8000

# Future: OpenAI or other provider keys (not used in v1)
# OPENAI_API_KEY=

# Future: application environment name
# ENVIRONMENT=development
